# Cấu hình Môi trường Ứng dụng
APP_ENV=production
APP_NAME="Cổng Thông Tin Điện Tử & Tin Tức"
APP_URL=https://localhost
APP_PORT=80
APP_SSL_PORT=443

# Cấu hình Cơ sở dữ liệu MySQL
MYSQL_ROOT_PASSWORD=StrongRootPassword20Char!#9
MYSQL_DATABASE=news_portal
MYSQL_USER=news_user
MYSQL_PASSWORD=NewsSecurePass20Char!7
MYSQL_PORT=3306

# Tài khoản giám sát cơ sở dữ liệu (MySQLd Exporter - Least Privilege)
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=ExporterPass20Char!99

# Cấu hình Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GrafanaAdminPass20Char!
GRAFANA_PORT=3000

# Cấu hình Prometheus
PROMETHEUS_PORT=9090

# Cấu hình Loki & Promtail
LOKI_PORT=3100
PROMTAIL_PORT=9080

# Cấu hình phpMyAdmin
PMA_PORT=8080
